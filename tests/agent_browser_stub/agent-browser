#!/usr/bin/env node
// Stand-in for the agent-browser CLI, put first on PATH so figma_run.py
// takes its cdp branch offline. It answers the two subcommands it
// uses, printing as the helper's perch branch assumes
// agent-browser prints:
//   --cdp <port> eval -b <base64>          the result as indented JSON, keys sorted;
//                                          a throw is "✗ Evaluation error: ..." on stderr, exit 1
//   --cdp <port> batch --json "eval -b <base64>"...
//                                          [{success:true, result:{origin, result}} | {success:false, error}]
// Scripts run as programs (vm.runInThisContext) in this one process, against
// tests/perch_stub's `figma`, so a batch's scripts share globals as a page does.
// Each script is appended to $AGENT_BROWSER_STUB_LOG as a JSON line.
"use strict";
const { appendFileSync } = require("node:fs");
const path = require("node:path");
const { pathToFileURL } = require("node:url");
const vm = require("node:vm");

const HREF = "https://www.figma.com/design/AAA111/Stub?node-id=0-1";

function sorted(v) {
  if (Array.isArray(v)) return v.map(sorted);
  if (v && typeof v === "object") return Object.fromEntries(Object.keys(v).sort().map((k) => [k, sorted(v[k])]));
  return v;
}

async function run(b64) {
  const src = Buffer.from(b64, "base64").toString("utf8");
  if (process.env.AGENT_BROWSER_STUB_LOG) appendFileSync(process.env.AGENT_BROWSER_STUB_LOG, JSON.stringify({ src }) + "\n");
  try {
    const v = await vm.runInThisContext(src);
    return { ok: true, value: v === undefined ? null : JSON.parse(JSON.stringify(v) ?? "null") };
  } catch (e) {
    // Node's vm prefixes a rethrown error's stack with a source excerpt; the name and message is what both backends lead with.
    return { ok: false, error: String(e) };
  }
}

async function main() {
  const argv = process.argv.slice(2);
  if (argv[0] === "--cdp") argv.splice(0, 2);
  await import(pathToFileURL(path.join(__dirname, "..", "perch_stub", "server.js")).href);
  globalThis.location = new URL(HREF);
  if (argv[0] === "eval" && argv[1] === "-b") {
    const r = await run(argv[2]);
    if (!r.ok) {
      process.stderr.write(`✗ Evaluation error: ${r.error}\n`);
      process.exitCode = 1;
      return;
    }
    process.stdout.write(JSON.stringify(sorted(r.value), null, 2) + "\n");
    return;
  }
  if (argv[0] === "batch" && argv[1] === "--json") {
    const out = [];
    for (const cmd of argv.slice(2)) {
      const m = /^eval -b (\S+)$/.exec(cmd);
      const r = m ? await run(m[1]) : { ok: false, error: `stub: unknown command ${cmd}` };
      out.push(r.ok ? { success: true, result: sorted({ origin: HREF, result: r.value }) }
        : { success: false, error: `Evaluation error: ${r.error}` });
    }
    process.stdout.write(JSON.stringify(out) + "\n");
    process.exitCode = out.every((r) => r.success) ? 0 : 1;
    return;
  }
  process.stderr.write(`agent-browser stub: unsupported ${argv.join(" ")}\n`);
  process.exitCode = 2;
}

main();
