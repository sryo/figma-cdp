{
  "_": "Which eval tasks a change to each file can move: case.py verify's gate 5 and run.py's default --tasks (through fium scope). Patterns are fnmatch globs over repo paths; the first that matches wins. \"*\" means every default task, \"none\" means no live run (a tooling or docs change is re-judged offline: reparse.py and gate.py on runs already kept). A file no rule matches could move anything, so it runs every task. A case's own repro task always runs too, which is how app-screens runs: only when it is the target. gates_test.py checks every skill file matches a pattern and every task exists.",
  "rules": [
    {"files": ["README.md", "GOALS.md", "AGENTS.md", "CLAUDE.md", "LICENSE", "docs/*", "tests/*"], "tasks": "none"},
    {"files": ["SKILL.md", "figma-worker.md"], "tasks": ["recon", "effects", "fidelity-edit"]},
    {"files": ["figma_run.py", "figma_perch.mjs"], "tasks": ["recon"]},
    {"files": ["references/building.md", "references/execution.md", "references/conventions.md", "references/gotchas.md"], "tasks": "*"},
    {"files": ["figma_lib.js", "figma_batch_run.py", "references/connection.md", "references/reading.md", "references/api-reference.md"], "tasks": ["recon", "effects", "fidelity-edit"]},
    {"files": ["figma_source.py", "figma_fidelity.py", "references/fidelity.md"], "tasks": ["fidelity-edit", "app-screens"]},
    {"files": ["figma_capture.py", "figma_importer.js", "figma_walker.js", "references/capture.md"], "tasks": ["capture"]},
    {"files": ["references/api-components.md"], "tasks": ["componentize", "variants", "reuse", "pattern-detect"]},
    {"files": ["references/api-layout.md"], "tasks": ["layout", "responsive", "app-screens"]},
    {"files": ["references/api-styling.md"], "tasks": ["effects", "variants", "fidelity-edit"]},
    {"files": ["references/api-text.md", "references/copy.md"], "tasks": ["fidelity-edit", "reuse"]},
    {"files": ["references/prototyping.md", "references/rest-api.md"], "tasks": ["recon"]}
  ]
}
